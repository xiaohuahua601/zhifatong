# ============================================================
# 智法通 - 企业级智能法律顾问平台 环境变量配置
# 说明: 复制此文件为 .env 并修改为实际值
# 命令: cp .env.example .env
# 警告: .env文件包含敏感信息，切勿提交到版本控制系统！
# ============================================================

# ----------------------------------------------------------
# 应用基础配置
# ----------------------------------------------------------
# 应用环境: development / testing / production
APP_ENV=production

# 系统名称
APP_NAME=智法通

# 日志级别: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# ----------------------------------------------------------
# MySQL 数据库配置
# ----------------------------------------------------------
# MySQL端口
MYSQL_PORT=3306

# 数据库名称
MYSQL_DATABASE=zhifatong

# root用户密码（生产环境请务必修改！）
MYSQL_ROOT_PASSWORD=zhifatong_root_2026

# 应用数据库用户名
MYSQL_USER=zhifatong

# 应用数据库密码（生产环境请务必修改！）
MYSQL_PASSWORD=zhifatong_pass_2026

# 数据库连接URL（后端使用，格式：mysql+aiomysql://用户:密码@主机:端口/数据库）
DATABASE_URL=mysql+aiomysql://zhifatong:zhifatong_pass_2026@mysql:3306/zhifatong?charset=utf8mb4

# ----------------------------------------------------------
# 后端服务配置
# ----------------------------------------------------------
# 后端服务端口
BACKEND_PORT=8000

# JWT密钥（生产环境请务必修改为随机长字符串！）
SECRET_KEY=zhifatong_secret_key_change_in_production_2026

# JWT Token过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ----------------------------------------------------------
# Ollama AI模型配置
# ----------------------------------------------------------
# Ollama服务地址
# Docker部署使用: http://ollama:11434
# 本地部署使用: http://host.docker.internal:11434
# 远程部署使用: http://your-server-ip:11434
OLLAMA_BASE_URL=http://ollama:11434

# Ollama服务端口
OLLAMA_PORT=11434

# AI模型名称
OLLAMA_MODEL=qwen2.5:7b

# AI生成温度参数（0.0~1.0，越高越随机）
AI_TEMPERATURE=0.7

# AI最大生成Token数
AI_MAX_TOKENS=4096

# ----------------------------------------------------------
# LangSmith 追踪配置
# ----------------------------------------------------------
# LangSmith API密钥
LANGSMITH_API_KEY=

# LangSmith项目名称
LANGSMITH_PROJECT_NAME=zhifatong-production

# LangSmith端点
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# 是否启用LangSmith追踪（true/false）
LANGSMITH_TRACING_ENABLED=false

# ----------------------------------------------------------
# Redis 配置
# ----------------------------------------------------------
# Redis主机
REDIS_HOST=localhost

# Redis端口
REDIS_PORT=6379

# Redis密码（无密码留空）
REDIS_PASSWORD=

# Redis数据库编号
REDIS_DB=0

# ----------------------------------------------------------
# RAG（检索增强生成）配置
# ----------------------------------------------------------
# 文档分块大小（字符数）
RAG_CHUNK_SIZE=500

# 分块重叠字符数
RAG_CHUNK_OVERLAP=50

# 检索返回Top-K数量
RAG_TOP_K=5

# 相似度阈值（低于此值的文档将被过滤）
RAG_SIMILARITY_THRESHOLD=0.7

# 重检索最大次数
RAG_RERETRIEVAL_MAX_RETRIES=2

# 重检索置信度阈值
RAG_RERETRIEVAL_CONFIDENCE_THRESHOLD=0.6

# ----------------------------------------------------------
# 合同审查配置
# ----------------------------------------------------------
# 高风险阈值（0-100，风险评分低于此值视为高风险）
CONTRACT_REVIEW_HIGH_RISK_THRESHOLD=80

# 是否启用中断恢复（true/false）
CONTRACT_REVIEW_INTERRUPT_ENABLED=true

# ----------------------------------------------------------
# 前端配置
# ----------------------------------------------------------
# 前端API基础地址
VITE_API_BASE_URL=/api

# ----------------------------------------------------------
# Nginx配置
# ----------------------------------------------------------
# HTTP端口
NGINX_HTTP_PORT=80

# HTTPS端口
NGINX_HTTPS_PORT=443

# ----------------------------------------------------------
# 文件上传配置
# ----------------------------------------------------------
# 允许上传的文件类型
ALLOWED_FILE_TYPES=pdf,doc,docx,txt

# 最大文件大小（MB）
MAX_FILE_SIZE_MB=20

# ----------------------------------------------------------
# 限流配置
# ----------------------------------------------------------
# 每分钟API请求限制
RATE_LIMIT_PER_MINUTE=30

# 每用户最大对话数
MAX_CONVERSATIONS_PER_USER=100

# 每用户最大合同数
MAX_CONTRACTS_PER_USER=50
